[Unit]
Description=API de ingesta (Data Startup Papeleria)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/data-startup-papeleria/services/ingesta
EnvironmentFile=/etc/papeleria.env
ExecStart=/home/ec2-user/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
