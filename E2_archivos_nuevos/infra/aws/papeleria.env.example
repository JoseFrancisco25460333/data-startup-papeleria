# /etc/papeleria.env  (chmod 600; NO se sube al repositorio)
BACKEND=aws
AWS_REGION=us-east-1
BUCKET=papeleria-datastartup-CAMBIA-ESTO
QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/papeleria-ingesta
# Base de datos (solo la usa el worker). En E4 estas credenciales pasan a Secrets Manager.
DB_HOST=localhost
DB_NAME=papeleria
DB_USER=papeleria
DB_PASSWORD=CAMBIA-ESTO
DB_SSLMODE=prefer
