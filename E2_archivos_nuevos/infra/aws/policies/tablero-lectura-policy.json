{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "ListaSoloClean", "Effect": "Allow", "Action": "s3:ListBucket",
     "Resource": "arn:aws:s3:::__BUCKET__",
     "Condition": {"StringLike": {"s3:prefix": ["clean/*"]}}},
    {"Sid": "LeeSoloClean", "Effect": "Allow", "Action": "s3:GetObject",
     "Resource": "arn:aws:s3:::__BUCKET__/clean/*"}
  ]
}
